---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Controls from '../components/Controls.astro';
import Footer from '../components/Footer.astro';
import { getLang, switchLangPath, useTranslations } from '../i18n';

interface Props {
  /** Page-specific title; the site name is appended. */
  title?: string;
  description?: string;
  /** Override the language switch target (e.g. the 404 page has no translated twin). */
  langSwitchHref?: string;
  /** Link preview image, a path under public/. Defaults to the site-wide card. */
  image?: string;
  /** Keep the page out of search results (the 404). */
  noindex?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const title = Astro.props.title ? `${Astro.props.title} · ${t.meta.title}` : t.meta.title;
const description = Astro.props.description ?? t.meta.description;

// Absolute URLs for search engines and link previews; `site` is set in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = {
  en: new URL(switchLangPath(Astro.url.pathname, 'en'), Astro.site),
  fr: new URL(switchLangPath(Astro.url.pathname, 'fr'), Astro.site),
};
const image = new URL(Astro.props.image ?? '/og.jpg', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <title>{title}</title>
    {Astro.props.noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="fr" href={alternates.fr} />
        <link rel="alternate" hreflang="x-default" href={alternates.en} />
        <link rel="sitemap" href="/sitemap-index.xml" />
      </>
    )}
    {/* Link previews (LinkedIn, Discord, WhatsApp, X…). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Runs before first paint so the page never flashes the wrong theme. */}
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        function apply(theme) {
          document.documentElement.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#09090b' : '#fafafa');
        }
        apply(stored === 'light' || stored === 'dark' ? stored : (media.matches ? 'dark' : 'light'));
        // Follow the OS setting live until the visitor picks a theme manually.
        media.addEventListener('change', function (e) {
          var manual = null;
          try { manual = localStorage.getItem('theme'); } catch (err) {}
          if (!manual) apply(e.matches ? 'dark' : 'light');
        });
        window.__applyTheme = apply;
      })();
    </script>
  </head>
  <body class="relative min-h-screen overflow-x-hidden">
    {/* Soft background glows: they give the navbar's blur something to show. */}
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
      <div class="absolute -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-accent/15 blur-3xl"></div>
      <div class="absolute top-[60%] -right-40 h-[28rem] w-[28rem] rounded-full bg-accent-2/10 blur-3xl"></div>
      <div class="absolute top-[30%] -left-40 h-[24rem] w-[24rem] rounded-full bg-accent/10 blur-3xl"></div>
    </div>

    <Navbar />
    <Controls langSwitchHref={Astro.props.langSwitchHref} />
    <slot />
    <Footer />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
