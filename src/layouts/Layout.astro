---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Controls from '../components/Controls.astro';
import Footer from '../components/Footer.astro';
import { getLang, useTranslations } from '../i18n';

interface Props {
  /** Page-specific title; the site name is appended. */
  title?: string;
  description?: string;
  /** Override the language switch target (e.g. the 404 page has no translated twin). */
  langSwitchHref?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const title = Astro.props.title ? `${Astro.props.title} · ${t.meta.title}` : t.meta.title;
const description = Astro.props.description ?? t.meta.description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {/* Runs before first paint so the page never flashes the wrong theme. */}
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        function apply(theme) {
          document.documentElement.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#09090b' : '#fafafa');
        }
        apply(stored === 'light' || stored === 'dark' ? stored : (media.matches ? 'dark' : 'light'));
        // Follow the OS setting live until the visitor picks a theme manually.
        media.addEventListener('change', function (e) {
          var manual = null;
          try { manual = localStorage.getItem('theme'); } catch (err) {}
          if (!manual) apply(e.matches ? 'dark' : 'light');
        });
        window.__applyTheme = apply;
      })();
    </script>
  </head>
  <body class="relative min-h-screen overflow-x-hidden">
    {/* Soft background glows: they give the navbar's blur something to show. */}
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
      <div class="absolute -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-accent/15 blur-3xl"></div>
      <div class="absolute top-[60%] -right-40 h-[28rem] w-[28rem] rounded-full bg-accent-2/10 blur-3xl"></div>
      <div class="absolute top-[30%] -left-40 h-[24rem] w-[24rem] rounded-full bg-accent/10 blur-3xl"></div>
    </div>

    <Navbar />
    <Controls langSwitchHref={Astro.props.langSwitchHref} />
    <slot />
    <Footer />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
