---
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { github, projects } from '../data/site';
import { getLang, localizePath, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="projects" class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeader index="04" title={t.projects.title} />

    <div class="grid gap-6 md:grid-cols-2">
        {projects.map((project) => {
            const text = t.projects.items[project.slug];
            return (
                <ProjectCard
                    title={text.title}
                    summary={text.summary}
                    tools={project.tools}
                    image={project.image}
                    link={project.link}
                    href={localizePath(`/projects/${project.slug}/`, lang)}
                    detailsLabel={t.projects.details}
                    githubLabel={t.projects.onGithub}
                />
            );
        })}
    </div>

    <div class="mt-12 flex justify-center" data-reveal>
        <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-full border border-tint/15 px-6 py-3 text-sm font-semibold transition-colors hover:bg-tint/5"
        >
            {t.projects.seeMore}
            <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
    </div>
</section>
