---
const links = [
    { href: "https://www.linkedin.com/in/matthieu-griffonnet/", label: "LinkedIn" },
    { href: "https://github.com/Matt-Griff", label: "Github" },
    // TODO: put your contact address after mailto:
    { href: "mailto:", label: "Mail" },
];
---

<footer class="mt-12 border-t border-tint/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 pt-12 pb-24 sm:pb-12 md:flex-row md:justify-between">
        <p class="text-sm text-muted">&copy; 2026 Matthieu Griffonnet's Portfolio. All rights reserved.</p>
        <ul class="flex gap-2">
            {links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        target={link.href.startsWith('http') ? '_blank' : undefined}
                        rel="noopener noreferrer"
                        class="rounded-full px-4 py-2 text-sm text-muted transition-colors hover:bg-tint/5 hover:text-ink"
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </div>
</footer>
