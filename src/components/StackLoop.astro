---
import '../styles/stack-loop.css';

const stackIcons = [
    { src: "/icons/devicon/c-original.svg", alt: "C" },
    { src: "/icons/devicon/java-original.svg", alt: "Java" },
    { src: "/icons/devicon/typescript-original.svg", alt: "TypeScript" },
    { src: "/icons/devicon/javascript-original.svg", alt: "JavaScript" },
    { src: "/icons/devicon/python-original.svg", alt: "Python" },
    { src: "/icons/devicon/postgresql-original.svg", alt: "SQL" },
    { src: "/icons/devicon/cplusplus-original.svg", alt: "C++" },
    { src: "/icons/devicon/bash-original.svg", alt: "Bash" },
    { src: "/icons/devicon/html5-original.svg", alt: "HTML" },
    { src: "/icons/devicon/css3-original.svg", alt: "CSS" },
    { src: "/icons/devicon/csharp-original.svg", alt: "C#" },
    { src: "/icons/devicon/angular-original.svg", alt: "Angular" },
    { src: "/icons/devicon/react-original.svg", alt: "React" },
    { src: "/icons/devicon/nodejs-original.svg", alt: "Node.js" },
    { src: "/icons/devicon/fastapi-original.svg", alt: "FastAPI" },
    { src: "/icons/devicon/docker-original.svg", alt: "Docker" },
    { src: "/icons/devicon/express-original.svg", alt: "Express.js" },
    { src: "/icons/devicon/spring-original.svg", alt: "Spring Boot" },
    { src: "/icons/devicon/dot-net-original.svg", alt: ".Net" },
    { src: "/icons/devicon/git-original.svg", alt: "Git" },
    { src: "/icons/devicon/linux-original.svg", alt: "Linux" },
    { src: "/icons/devicon/pytorch-original.svg", alt: "PyTorch" },
    { src: "/icons/devicon/opencv-original.svg", alt: "OpenCV" },
    { src: "/icons/devicon/junit-original.svg", alt: "JUnit" },
    { src: "/icons/devicon/rabbitmq-original.svg", alt: "RabbitMQ" },
    { src: "/icons/devicon/githubactions-original.svg", alt: "CI/CD" },
];
---

<div class="marquee" aria-label="Tech stack">
    <div class="marquee-track">
        {stackIcons.map((icon) => (
            <div class="marquee-item">
                <img src={icon.src} alt={icon.alt} />
            </div>
        ))}
    </div>
    <div aria-hidden="true" class="marquee-track">
        {stackIcons.map((icon) => (
            <div class="marquee-item">
                <img src={icon.src} alt={icon.alt} />
            </div>
        ))}
    </div>
</div>
