---
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<section class="mx-auto flex min-h-[92vh] max-w-6xl flex-col justify-center px-6 pt-24">
    <p class="mb-6 inline-flex w-fit items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 text-sm font-medium text-emerald-700 dark:text-emerald-300">
        <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75 motion-reduce:animate-none"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        {t.hero.badge}
    </p>
    <p class="mb-6 font-display text-sm font-semibold uppercase tracking-[0.3em] text-muted">{t.hero.eyebrow}</p>
    <h1 class="font-display text-6xl leading-[0.95] font-bold tracking-tight md:text-9xl">
        <span class="name block min-h-[1em]">Matthieu</span>
        <span class="last-name text-gradient block min-h-[1em] md:ml-32">Griffonnet</span>
    </h1>
    <p class="mt-8 flex min-h-[2em] items-center text-xl text-muted md:text-2xl">
        <span class="desc" aria-live="off" data-citations={JSON.stringify(t.hero.citations)}>{t.hero.citations[0]}</span>
        <span class="ml-1 inline-block h-6 w-0.5 animate-pulse bg-accent md:h-7"></span>
    </p>
    <div class="mt-12 flex flex-wrap gap-4">
        <a
            href="#projects"
            class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-canvas transition-transform hover:-translate-y-0.5"
        >
            {t.hero.projects}
        </a>
        <a
            href="#contact"
            class="rounded-full border border-tint/15 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-tint/5"
        >
            {t.hero.contact}
        </a>
        <a
            href={t.hero.cvHref}
            download
            class="inline-flex items-center gap-2 rounded-full border border-tint/15 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-tint/5"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
            </svg>
            {t.hero.cv}
        </a>
    </div>
</section>

<script>
    import gsap from "gsap";
    import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
    import { TextPlugin } from "gsap/TextPlugin";

    gsap.registerPlugin(ScrambleTextPlugin, TextPlugin);

    // Taglines come from the page language (see src/i18n).
    const desc = document.querySelector<HTMLElement>(".desc")!;
    const citations: string[] = JSON.parse(desc.dataset.citations ?? "[]");

    // The name is in the HTML (for search engines and screen readers); scramble it in from scratch.
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reducedMotion) {
        gsap.from(".name", {
            duration: 1,
            scrambleText: {
                text: ""
            }
        });

        gsap.from(".last-name", {
            duration: 1,
            scrambleText: {
                text: ""
            }
        });
    }

    async function changeDesc() {
        while (true) {
            await new Promise(resolve => setTimeout(resolve, 4000));
            // Skip work while the tab is in the background.
            if (document.hidden) continue;
            const citation = citations[Math.floor(Math.random() * citations.length)];
            gsap.to(".desc", {
                duration: reducedMotion ? 0 : 2,
                text: citation,
            });
        }
    }

    changeDesc();
</script>
