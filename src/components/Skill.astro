---
import SectionHeader from './SectionHeader.astro';
import StackLoop from './StackLoop.astro';

const skillGroups = [
    {
        title: "Programming Languages",
        items: ["C", "Java", "TypeScript", "JavaScript", "Python", "SQL", "C++", "Bash", "HTML", "CSS", "C#"],
    },
    {
        title: "Frameworks & Tools",
        items: ["Angular", "React", "Node.js", "FastAPI", "Docker", "Express.js", "Spring Boot", ".Net", "Git", "Linux", "JUnit", "RabbitMQ", "Cucumber", "CI/CD"],
    },
    {
        title: "Computer Vision & AI",
        items: ["PyTorch", "OpenCV", "FAISS", "Deep Learning", "Machine Learning"],
    },
    {
        title: "Spoken Languages",
        items: ["French", "English (C1 – TOEIC 960)", "Spanish (B1)"],
    },
];
---

<section id="skills" class="py-24">
    <div class="mx-auto max-w-6xl px-6">
        <SectionHeader index="03" title="Skills" />

        <div class="grid gap-6 md:grid-cols-2">
            {skillGroups.map((group) => (
                <div class="rounded-3xl border border-tint/10 bg-surface/60 p-8" data-reveal-batch>
                    <h3 class="mb-6 font-display text-lg font-semibold">{group.title}</h3>
                    <ul class="flex flex-wrap gap-2">
                        {group.items.map((item) => (
                            <li class="rounded-full border border-tint/10 bg-tint/5 px-4 py-1.5 text-sm text-muted transition-colors hover:border-accent/50 hover:text-ink">
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>

    <div class="mt-16">
        <StackLoop />
    </div>
</section>
