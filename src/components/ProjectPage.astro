---
// Detail page for one project, shared by /projects/[slug]/ and /fr/projects/[slug]/.
import Layout from '../layouts/Layout.astro';
import { projects, type ProjectSlug } from '../data/site';
import { getLang, localizePath, useTranslations } from '../i18n';

interface Props {
    slug: string | undefined;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const index = projects.findIndex((p) => p.slug === Astro.props.slug);
const project = projects[index];
const text = t.projects.items[project.slug as ProjectSlug];
const labels = t.projects.page;

const prev = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const pageHref = (slug: string) => localizePath(`/projects/${slug}/`, lang);
---

<Layout title={text.title} description={text.summary} image={project.image.replace("/projects/", "/og/").replace(".webp", ".jpg")}>
    <article class="mx-auto max-w-4xl px-6 pt-28 pb-24 lg:pt-32">
        <a
            href={`${localizePath('/', lang)}#projects`}
            class="group inline-flex items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-ink"
        >
            <span class="transition-transform group-hover:-translate-x-1">←</span>
            {labels.back}
        </a>

        <header class="mt-8">
            <h1 class="font-display text-4xl font-bold tracking-tight md:text-6xl">{text.title}</h1>
            <p class="mt-6 text-lg leading-relaxed text-muted md:text-xl">{text.intro}</p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
                <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-canvas transition-transform hover:-translate-y-0.5"
                >
                    {labels.source}
                </a>
            </div>
        </header>

        <div class="mt-12 aspect-[16/9] overflow-hidden rounded-3xl border border-tint/10 bg-tint/5">
            <img src={project.image} alt="" class="h-full w-full object-cover" />
        </div>

        <div class="mt-12 grid gap-12 md:grid-cols-[1fr_14rem]">
            <div class="space-y-10">
                {text.sections.map((section) => (
                    <section data-reveal>
                        <h2 class="font-display text-2xl font-bold tracking-tight">{section.heading}</h2>
                        {section.text && <p class="mt-4 leading-relaxed text-muted">{section.text}</p>}
                        {section.bullets && (
                            <ul class="mt-4 space-y-2 leading-relaxed text-muted">
                                {section.bullets.map((bullet) => (
                                    <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:h-1.5 before:w-1.5 before:rounded-full before:bg-accent">
                                        {bullet}
                                    </li>
                                ))}
                            </ul>
                        )}
                    </section>
                ))}
            </div>

            <aside class="space-y-8 md:sticky md:top-28 md:self-start">
                <div>
                    <h2 class="text-xs font-semibold tracking-widest text-muted uppercase">{labels.stack}</h2>
                    <ul class="mt-3 flex flex-wrap gap-2">
                        {project.tools.map((tool) => (
                            <li class="rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">{tool}</li>
                        ))}
                    </ul>
                </div>
                {text.team && (
                    <div>
                        <h2 class="text-xs font-semibold tracking-widest text-muted uppercase">{labels.team}</h2>
                        <p class="mt-3 text-sm leading-relaxed">{text.team}</p>
                    </div>
                )}
            </aside>
        </div>

        {project.gallery.length > 0 && (
            <section class="mt-16">
                <h2 class="font-display text-2xl font-bold tracking-tight">{labels.gallery}</h2>
                <div class="mt-6 grid gap-6 md:grid-cols-2">
                    {project.gallery.map((src, i) => (
                        <figure class="overflow-hidden rounded-3xl border border-tint/10 bg-surface/60" data-reveal-batch>
                            <a href={src} target="_blank" rel="noopener">
                                <img src={src} alt={text.captions[i] ?? ''} loading="lazy" class="w-full transition-transform duration-500 hover:scale-105" />
                            </a>
                            {text.captions[i] && <figcaption class="px-5 py-3 text-sm text-muted">{text.captions[i]}</figcaption>}
                        </figure>
                    ))}
                </div>
            </section>
        )}

        <nav class="mt-20 grid gap-4 border-t border-tint/10 pt-10 sm:grid-cols-2">
            <a href={pageHref(prev.slug)} class="group rounded-3xl border border-tint/10 p-6 transition-colors hover:border-accent/40">
                <span class="text-xs font-semibold tracking-widest text-muted uppercase">← {labels.prev}</span>
                <span class="mt-2 block font-display text-xl font-semibold">{t.projects.items[prev.slug].title}</span>
            </a>
            <a href={pageHref(next.slug)} class="group rounded-3xl border border-tint/10 p-6 text-right transition-colors hover:border-accent/40">
                <span class="text-xs font-semibold tracking-widest text-muted uppercase">{labels.next} →</span>
                <span class="mt-2 block font-display text-xl font-semibold">{t.projects.items[next.slug].title}</span>
            </a>
        </nav>
    </article>
</Layout>
