---
interface Props {
    title: string;
    summary: string;
    tools: readonly string[];
    image: string;
    link: string;
    href: string;
    detailsLabel: string;
    githubLabel: string;
}

const { title, summary, tools, image, link, href, detailsLabel, githubLabel } = Astro.props;
---

<article
    class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-tint/10 bg-surface/60 transition-colors hover:border-accent/40"
    data-reveal-batch
>
    {/* Image */}
    <div class="aspect-[16/9] overflow-hidden border-b border-tint/10 bg-tint/5">
        <img
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            src={image}
            alt=""
            loading="lazy"
        />
    </div>

    <div class="flex flex-1 flex-col p-6 md:p-8">
        {/* Header: title (links to the project page, and stretches over the whole card) & GitHub icon */}
        <div class="mb-4 flex items-start justify-between gap-4">
            <h3 class="font-display text-2xl font-bold tracking-tight md:text-3xl">
                <a href={href} class="after:absolute after:inset-0">{title}</a>
            </h3>
            <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${title} ${githubLabel}`}
                class="relative z-10 shrink-0 rounded-full border border-tint/10 p-2 text-muted transition-colors hover:border-accent/50 hover:text-ink"
            >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                    <path d="M12 2C6.477 2 2 6.484 2 12.021c0 4.428 2.865 8.184 6.839 9.504.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.004.07 1.532 1.032 1.532 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.339-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.025A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.295 2.748-1.025 2.748-1.025.546 1.378.202 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.847-2.337 4.695-4.566 4.944.359.309.678.919.678 1.852 0 1.336-.012 2.417-.012 2.747 0 .267.18.578.688.48C19.138 20.2 22 16.447 22 12.021 22 6.484 17.523 2 12 2z" />
                </svg>
            </a>
        </div>

        {/* List of tools */}
        <ul class="mb-5 flex flex-wrap gap-2">
            {tools.map((tool) => (
                <li class="rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">{tool}</li>
            ))}
        </ul>

        {/* Summary */}
        <p class="text-sm leading-relaxed text-muted md:text-base">{summary}</p>

        <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent" aria-hidden="true">
            {detailsLabel}
            <span class="transition-transform group-hover:translate-x-1">→</span>
        </span>
    </div>
</article>
