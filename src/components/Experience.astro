---
import SectionHeader from './SectionHeader.astro';
import { experiences as experienceData } from '../data/site';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const experiences = experienceData.map(({ id, stack }) => ({ ...t.experience.items[id], stack }));
---

<section id="experience" class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeader index="02" title={t.experience.title} />

    <ol class="space-y-6">
        {experiences.map((exp) => (
            <li
                class="grid gap-6 rounded-3xl border border-tint/10 bg-surface/60 p-6 transition-colors hover:border-accent/40 md:grid-cols-[14rem_1fr] md:p-8"
                data-reveal-batch
            >
                <div>
                    <p class="font-display text-sm font-semibold text-accent">{exp.dates}</p>
                    <p class="mt-2 font-semibold">{exp.company}</p>
                    <p class="text-sm text-muted">{exp.location}</p>
                </div>

                <div>
                    <h3 class="font-display text-xl font-bold tracking-tight md:text-2xl">{exp.title}</h3>
                    {exp.highlight && (
                        <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
                            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                            {exp.highlight}
                        </p>
                    )}
                    <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted md:text-base">
                        {exp.bullets.map((bullet) => (
                            <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:h-1.5 before:w-1.5 before:rounded-full before:bg-tint/30">
                                {bullet}
                            </li>
                        ))}
                    </ul>
                    {exp.stack.length > 0 && (
                        <ul class="mt-5 flex flex-wrap gap-2">
                            {exp.stack.map((tool) => (
                                <li class="rounded-full border border-tint/10 bg-tint/5 px-3 py-1 text-xs text-muted">{tool}</li>
                            ))}
                        </ul>
                    )}
                </div>
            </li>
        ))}
    </ol>
</section>
