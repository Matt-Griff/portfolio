---
import SectionHeader from './SectionHeader.astro';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<section id="about" class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeader index="01" title={t.about.title} />

    <div class="max-w-3xl space-y-6 text-lg leading-relaxed text-muted">
        {t.about.paragraphs.map((paragraph) => <p data-reveal set:html={paragraph} />)}
    </div>
</section>
