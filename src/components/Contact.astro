---
import SectionHeader from './SectionHeader.astro';

const contacts = [
    {
        label: "LinkedIn",
        handle: "matthieu-griffonnet",
        href: "https://www.linkedin.com/in/matthieu-griffonnet/",
        icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
        fill: true,
    },
    {
        label: "GitHub",
        handle: "Matt-Griff",
        href: "https://github.com/Matt-Griff",
        icon: "M12 2C6.477 2 2 6.484 2 12.021c0 4.428 2.865 8.184 6.839 9.504.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.004.07 1.532 1.032 1.532 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.339-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.025A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.295 2.748-1.025 2.748-1.025.546 1.378.202 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.847-2.337 4.695-4.566 4.944.359.309.678.919.678 1.852 0 1.336-.012 2.417-.012 2.747 0 .267.18.578.688.48C19.138 20.2 22 16.447 22 12.021 22 6.484 17.523 2 12 2z",
        fill: true,
    },
    {
        label: "Mail",
        handle: "matthieu.griffonnet1@gmail.com",
        href: "mailto:matthieu.griffonnet1@gmail.com",
        icon: "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM22 6l-10 7L2 6",
        fill: false,
    },
];
---

<section id="contact" class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeader index="06" title="Contact Me" />

    <p class="mb-10 max-w-2xl text-lg leading-relaxed text-muted" data-reveal>
        Looking for an intern for a <span class="font-semibold text-accent">6-month end-of-studies internship in embedded systems</span>?
        Pick whichever way suits you best.
    </p>

    <ul class="grid gap-6 md:grid-cols-3">
        {contacts.map((contact) => (
            <li data-reveal-batch>
                <a
                    href={contact.href}
                    target={contact.href.startsWith('http') ? '_blank' : undefined}
                    rel="noopener noreferrer"
                    class="group flex h-full flex-col gap-6 rounded-3xl border border-tint/10 bg-surface/60 p-8 transition-all hover:-translate-y-1 hover:border-accent/50"
                >
                    <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-canvas">
                        {contact.fill ? (
                            <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d={contact.icon} /></svg>
                        ) : (
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><path d={contact.icon} /></svg>
                        )}
                    </span>
                    <span class="mt-auto">
                        <span class="flex items-center justify-between font-display text-xl font-semibold">
                            {contact.label}
                            <span class="text-muted transition-transform group-hover:translate-x-1 group-hover:text-accent">→</span>
                        </span>
                        <span class="mt-1 block truncate text-sm text-muted">{contact.handle}</span>
                    </span>
                </a>
            </li>
        ))}
    </ul>
</section>
