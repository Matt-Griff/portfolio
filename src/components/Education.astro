---
import SectionHeader from './SectionHeader.astro';
import { education } from '../data/site';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

// Oldest at the top: the rocket flies down from the first diploma to "What's next ?".
const entries = education.map(({ id, logo, years }) => ({ ...t.education.items[id], logo, years }));
---

<section id="education" class="mx-auto flex max-w-5xl flex-col justify-center px-6 py-24 md:min-h-screen md:py-20">
    <SectionHeader index="05" title={t.education.title} />

    <div class="relative" data-timeline>
        {/* Zig-zag flight path and rocket, positioned by the script below (desktop only). */}
        <svg class="pointer-events-none absolute inset-0 hidden h-full w-full overflow-visible md:block" aria-hidden="true" data-flight>
            <defs>
                <linearGradient id="flight-gradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--color-accent)" />
                    <stop offset="100%" stop-color="var(--color-accent-2)" />
                </linearGradient>
            </defs>
            <path data-flight-track fill="none" stroke="var(--color-tint)" stroke-opacity="0.15" stroke-width="2" stroke-dasharray="6 8" />
            <path data-flight-progress fill="none" stroke="url(#flight-gradient)" stroke-width="3" stroke-linecap="round" />
        </svg>

        <div class="pointer-events-none absolute top-0 left-0 z-10 hidden h-12 w-12 md:block" aria-hidden="true" data-rocket>
            <svg viewBox="0 0 64 64" class="h-full w-full drop-shadow-lg">
                <path class="rocket-flame" d="M25 47h14l-7 15z" fill="#f97316" />
                <path d="M18 36l-9 12v7l9-5zM46 36l9 12v7l-9-5z" fill="var(--color-accent)" />
                <path d="M32 3c9 8 14 20 14 33v12H18V36c0-13 5-25 14-33z" fill="var(--color-ink)" />
                <circle cx="32" cy="25" r="6" fill="var(--color-accent-2)" stroke="var(--color-canvas)" stroke-width="2" />
            </svg>
        </div>

        <ol class="relative flex flex-col gap-6 md:gap-3">
            {entries.map((edu, i) => {
                const side = i % 2 === 0 ? 'right' : 'left';
                return (
                    <li
                        data-edu
                        data-side={side}
                        data-reached="true"
                        class:list={[
                            'flex items-center gap-4 rounded-3xl border border-tint/10 bg-surface/80 p-4 backdrop-blur-sm transition-all duration-500 md:w-[40%] md:[&:not(:first-child)]:-mt-10',
                            'opacity-40 data-[reached=true]:border-accent/40 data-[reached=true]:opacity-100',
                            side === 'right' ? 'md:self-end' : 'md:self-start',
                        ]}
                    >
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full border border-tint/10 bg-white p-1">
                            <img src={edu.logo} alt={edu.school + ' logo'} class="h-full w-full object-contain" />
                        </span>
                        <div class="min-w-0">
                            <span class="text-xs font-semibold text-accent">{edu.years}</span>
                            <h3 class="font-display text-lg leading-tight font-semibold">{edu.degree}</h3>
                            <p class="text-sm text-muted">{edu.school}</p>
                            {edu.description && <p class="mt-1 text-xs text-muted">{edu.description}</p>}
                        </div>
                    </li>
                );
            })}
        </ol>
    </div>
</section>

<style>
    .rocket-flame {
        transform-origin: 32px 47px;
        animation: flicker 0.15s infinite alternate;
    }

    @keyframes flicker {
        from {
            transform: scaleY(0.75);
            opacity: 0.8;
        }

        to {
            transform: scaleY(1.1);
            opacity: 1;
        }
    }
</style>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

    gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

    const section = document.getElementById('education')!;
    const timeline = section.querySelector<HTMLElement>('[data-timeline]')!;
    const svg = section.querySelector<SVGSVGElement>('[data-flight]')!;
    const track = section.querySelector<SVGPathElement>('[data-flight-track]')!;
    const progress = section.querySelector<SVGPathElement>('[data-flight-progress]')!;
    const rocket = section.querySelector<HTMLElement>('[data-rocket]')!;
    // DOM order is top to bottom, which is also the flight order.
    const cards = [...section.querySelectorAll<HTMLElement>('[data-edu]')];

    // Build a smooth zig-zag through the inner edge of each card, from the top card down.
    function buildPath() {
        const box = timeline.getBoundingClientRect();
        svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);

        const points = cards.map((card) => {
            const r = card.getBoundingClientRect();
            const x = card.dataset.side === 'left' ? r.right + 40 : r.left - 40;
            return { x: x - box.left, y: r.top + r.height / 2 - box.top };
        });
        const first = cards[0].getBoundingClientRect();
        const last = cards[cards.length - 1].getBoundingClientRect();
        points.unshift({ x: box.width / 2, y: first.top - box.top - 20 });
        points.push({ x: box.width / 2, y: last.bottom - box.top + 20 });

        let d = `M${points[0].x},${points[0].y}`;
        for (let i = 1; i < points.length; i++) {
            const a = points[i - 1];
            const b = points[i];
            const midY = (a.y + b.y) / 2;
            d += ` C${a.x},${midY} ${b.x},${midY} ${b.x},${b.y}`;
        }
        track.setAttribute('d', d);
        progress.setAttribute('d', d);
    }

    // A card lights up once the rocket has flown past its centre.
    function markReached() {
        const rocketY = rocket.getBoundingClientRect().top + rocket.offsetHeight / 2;
        cards.forEach((card) => {
            const r = card.getBoundingClientRect();
            card.dataset.reached = String(rocketY >= r.top + r.height / 2 - 4);
        });
    }

    const mm = gsap.matchMedia();

    mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
        buildPath();
        ScrollTrigger.addEventListener('refreshInit', buildPath);
        const length = () => progress.getTotalLength();

        const tl = gsap.timeline({
            defaults: { ease: 'none' },
            // On the timeline (not the ScrollTrigger) so it tracks the smoothed rocket position.
            onUpdate: markReached,
            scrollTrigger: {
                trigger: section,
                start: 'top top',
                end: '+=1400',
                pin: true,
                // Pinning adds scroll space: refresh this before the reveal triggers further down the page.
                refreshPriority: 1,
                scrub: 0.6,
                invalidateOnRefresh: true,
                onRefresh: markReached,
            },
        });

        tl.fromTo(
            progress,
            { strokeDasharray: length, strokeDashoffset: length },
            { strokeDashoffset: 0 },
            0
        ).to(
            rocket,
            {
                motionPath: { path: progress, align: progress, alignOrigin: [0.5, 0.5], autoRotate: 90 },
            },
            0
        );

        return () => {
            ScrollTrigger.removeEventListener('refreshInit', buildPath);
            cards.forEach((card) => (card.dataset.reached = 'true'));
        };
    });
</script>
