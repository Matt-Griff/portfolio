---
import SectionHeader from './SectionHeader.astro';
import { education } from '../data/site';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

// Oldest at the top: the drone flies down from the first diploma and lands on the grass below "What's next ?".
const entries = education.map(({ id, logo, years }) => ({ ...t.education.items[id], logo, years }));
---

<section id="education" class="mx-auto flex max-w-5xl flex-col justify-center px-6 py-16 md:min-h-screen md:py-20">
    <SectionHeader index="05" title={t.education.title} file="education.md" />

    <div class="relative" data-timeline>
        {/* Zig-zag flight path, positioned by the script below (desktop only). The 3D drone and grass are a WebGL canvas added by src/scripts/drone-scene.ts. */}
        <svg class="pointer-events-none absolute inset-0 hidden h-full w-full overflow-visible md:block" aria-hidden="true" data-flight>
            <defs>
                <linearGradient id="flight-gradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--color-accent)" />
                    <stop offset="100%" stop-color="var(--color-accent-2)" />
                </linearGradient>
            </defs>
            <path data-flight-track fill="none" stroke="var(--color-tint)" stroke-opacity="0.15" stroke-width="2" stroke-dasharray="6 8" />
            <path data-flight-progress fill="none" stroke="url(#flight-gradient)" stroke-width="3" stroke-linecap="round" />
        </svg>

        <ol class="relative flex flex-col gap-6 md:gap-3">
            {entries.map((edu, i) => {
                const side = i % 2 === 0 ? 'right' : 'left';
                return (
                    <li
                        data-edu
                        data-side={side}
                        data-reached="true"
                        class:list={[
                            'flex items-center gap-4 rounded-3xl border border-tint/10 bg-surface/80 p-4 backdrop-blur-sm transition-all duration-500 md:w-[40%] md:[&:not(:first-child)]:-mt-10',
                            'opacity-40 data-[reached=true]:border-accent/40 data-[reached=true]:opacity-100',
                            side === 'right' ? 'md:self-end' : 'md:self-start',
                        ]}
                    >
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full border border-tint/10 bg-white p-1">
                            <img src={edu.logo} alt={edu.school + ' logo'} class="h-full w-full object-contain" />
                        </span>
                        <div class="min-w-0">
                            <span class="text-xs font-semibold text-accent">{edu.years}</span>
                            <h3 class="font-display text-lg leading-tight font-semibold">{edu.degree}</h3>
                            <p class="text-sm text-muted">{edu.school}</p>
                            {edu.description && <p class="mt-1 text-xs text-muted">{edu.description}</p>}
                        </div>
                    </li>
                );
            })}
        </ol>

        {/* Space for the grass the drone lands on (desktop only). */}
        <div class="hidden h-40 md:block" aria-hidden="true" data-ground></div>
    </div>
</section>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { MotionPathPlugin } from 'gsap/MotionPathPlugin';
    import type { DroneState } from '../scripts/drone-scene';

    gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

    // Keep in sync with DRONE_FEET in drone-scene.ts (that module is loaded lazily).
    const DRONE_FEET = 16;
    // Ground level, measured down from the top of the grass spacer.
    const GROUND_OFFSET = 100;

    type Scene = NonNullable<ReturnType<typeof import('../scripts/drone-scene').createDroneScene>>;

    const section = document.getElementById('education')!;
    const timeline = section.querySelector<HTMLElement>('[data-timeline]')!;
    const svg = section.querySelector<SVGSVGElement>('[data-flight]')!;
    const track = section.querySelector<SVGPathElement>('[data-flight-track]')!;
    const progress = section.querySelector<SVGPathElement>('[data-flight-progress]')!;
    const ground = section.querySelector<HTMLElement>('[data-ground]')!;
    // DOM order is top to bottom, which is also the flight order.
    const cards = [...section.querySelectorAll<HTMLElement>('[data-edu]')];

    // Drone position in timeline pixels, written by GSAP and read by the 3D scene every frame.
    const state: DroneState = { x: 0, y: 0, progress: 0 };
    let groundPoint = { x: 0, y: 0 };
    let landing = { x: 0, y: 0 };

    // Build a smooth zig-zag through the inner edge of each card, from the top card down to the grass.
    function buildPath() {
        const box = timeline.getBoundingClientRect();
        svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);

        const points = cards.map((card) => {
            const r = card.getBoundingClientRect();
            const x = card.dataset.side === 'left' ? r.right + 40 : r.left - 40;
            return { x: x - box.left, y: r.top + r.height / 2 - box.top };
        });
        const first = cards[0].getBoundingClientRect();
        const g = ground.getBoundingClientRect();
        groundPoint = { x: box.width / 2, y: g.top - box.top + GROUND_OFFSET };
        // Skids sink slightly into the grass.
        landing = { x: groundPoint.x, y: groundPoint.y - DRONE_FEET + 2 };
        points.unshift({ x: box.width / 2, y: first.top - box.top - 20 });
        points.push(landing);

        let d = `M${points[0].x},${points[0].y}`;
        for (let i = 1; i < points.length; i++) {
            const a = points[i - 1];
            const b = points[i];
            const midY = (a.y + b.y) / 2;
            d += ` C${a.x},${midY} ${b.x},${midY} ${b.x},${b.y}`;
        }
        track.setAttribute('d', d);
        progress.setAttribute('d', d);
    }

    // A card lights up once the drone has flown past its centre.
    function markReached() {
        const box = timeline.getBoundingClientRect();
        cards.forEach((card) => {
            const r = card.getBoundingClientRect();
            card.dataset.reached = String(state.y >= r.top - box.top + r.height / 2 - 4);
        });
    }

    // Load three.js only on desktop, and only once this section is set up.
    function loadScene(animate: boolean, onReady: (scene: Scene) => void) {
        let cancelled = false;
        import('../scripts/drone-scene')
            .then(({ createDroneScene }) => {
                if (cancelled) return;
                const scene = createDroneScene(timeline, state, { animate });
                if (scene) onReady(scene);
            })
            .catch(() => {});
        return () => (cancelled = true);
    }

    function syncScene(scene: Scene | null) {
        if (!scene) return;
        const box = timeline.getBoundingClientRect();
        scene.setSize(box.width, box.height);
        scene.setGround(groundPoint.x, groundPoint.y, box.width / 2);
    }

    const mm = gsap.matchMedia();

    mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
        let scene: Scene | null = null;
        const onRefresh = () => syncScene(scene);

        buildPath();
        ScrollTrigger.addEventListener('refreshInit', buildPath);
        ScrollTrigger.addEventListener('refresh', onRefresh);
        const length = () => progress.getTotalLength();

        const tl = gsap.timeline({
            defaults: { ease: 'none' },
            // On the timeline (not the ScrollTrigger) so it tracks the smoothed drone position.
            onUpdate() {
                state.progress = this.progress();
                markReached();
            },
            scrollTrigger: {
                trigger: section,
                start: 'top top',
                end: '+=1400',
                pin: true,
                // Pinning adds scroll space: refresh this before the reveal triggers further down the page.
                refreshPriority: 1,
                scrub: 0.6,
                invalidateOnRefresh: true,
                onRefresh: markReached,
            },
        });

        tl.fromTo(
            progress,
            { strokeDasharray: length, strokeDashoffset: length },
            { strokeDashoffset: 0 },
            0
        ).to(state, { motionPath: { path: progress } }, 0);

        const cancelLoad = loadScene(true, (s) => {
            scene = s;
            syncScene(scene);
        });

        return () => {
            cancelLoad();
            scene?.dispose();
            ScrollTrigger.removeEventListener('refreshInit', buildPath);
            ScrollTrigger.removeEventListener('refresh', onRefresh);
            cards.forEach((card) => (card.dataset.reached = 'true'));
        };
    });

    // Reduced motion on desktop: no flight, the drone is drawn once, already on the grass.
    mm.add('(min-width: 768px) and (prefers-reduced-motion: reduce)', () => {
        let scene: Scene | null = null;
        const place = () => {
            buildPath();
            Object.assign(state, landing, { progress: 1 });
            syncScene(scene);
        };
        place();
        window.addEventListener('resize', place);
        const cancelLoad = loadScene(false, (s) => {
            scene = s;
            place();
        });

        return () => {
            cancelLoad();
            scene?.dispose();
            window.removeEventListener('resize', place);
        };
    });
</script>
